{
  "functions": {
    "api/design.js": {
      "maxDuration": 120,
      "includeFiles": "img/**"
    }
  },
  "rewrites": [
    {
      "source": "/s/:id",
      "destination": "/api/s?id=:id"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/admin(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}