{
  "functions": {
    "api/design.js": {
      "maxDuration": 120,
      "includeFiles": "img/{orig,pack,style}/**"
    },
    "api/office.js": {
      "maxDuration": 300,
      "includeFiles": "{agents/**,js/biz.mjs,index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/s/:id",
      "destination": "/api/s?id=:id"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/admin(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "cat"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Link",
          "value": "<https://build.noyaglobal.com/>; rel=\"canonical\""
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/office?a=backup",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/office?a=digest",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/office?a=aidaily",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/office?a=aiboard",
      "schedule": "0 5 * * 0"
    }
  ],
  "redirects": [
    {
      "source": "/p/p75",
      "destination": "/c/serve/",
      "permanent": true
    },
    {
      "source": "/p/p75/",
      "destination": "/c/serve/",
      "permanent": true
    },
    {
      "source": "/p/p75a",
      "destination": "/c/serve/",
      "permanent": true
    },
    {
      "source": "/p/p75a/",
      "destination": "/c/serve/",
      "permanent": true
    },
    {
      "source": "/guides",
      "destination": "/gifts/",
      "permanent": true
    },
    {
      "source": "/guides/",
      "destination": "/gifts/",
      "permanent": true
    },
    {
      "source": "/c",
      "destination": "/gifts/",
      "permanent": true
    },
    {
      "source": "/c/",
      "destination": "/gifts/",
      "permanent": true
    },
    {
      "source": "/kelim",
      "destination": "/gifts/",
      "permanent": true
    },
    {
      "source": "/kelim/",
      "destination": "/gifts/",
      "permanent": true
    },
    {
      "source": "/p",
      "destination": "/gifts/",
      "permanent": true
    },
    {
      "source": "/p/",
      "destination": "/gifts/",
      "permanent": true
    }
  ]
}